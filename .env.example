# Aplicação
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://seu-dominio.up.railway.app
PUBLIC_WHATSAPP_NUMBER=5555999999999
TIMEZONE=America/Sao_Paulo
COOKIE_SECRET=troque-por-uma-frase-aleatoria-com-mais-de-32-caracteres
ADMIN_NAME=Lucas
ADMIN_EMAIL=seu-email@exemplo.com
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Bancos provisionados na Railway
DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_SSL=false
REDIS_URL=${{Redis.REDIS_URL}}

# Travas iniciais: mantenha assim durante o piloto
GLOBAL_PAUSE=true
SEED_DEMO=false
SALES_MODE=approval
PAYMENT_MODE=simulation
WHATSAPP_MODE=simulation
BITPANEL_MODE=disabled
RENEWAL_REQUIRES_APPROVAL=true
AI_ADMIN_ENABLED=false
AI_WHATSAPP_ENABLED=false

# Mercado Pago
# Cole os valores apenas em Variables na Railway. Nunca publique credenciais no GitHub.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICATION_URL=https://gateoneserver-production.up.railway.app/webhooks/mercadopago
MERCADOPAGO_PAYER_EMAIL=pagamentos@seu-dominio.com.br
PIX_EXPIRATION_MINUTES=60

# WhatsApp Cloud API / Meta
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_TEMPLATE_D3=gate_one_vencimento_d3
WHATSAPP_TEMPLATE_D0=gate_one_vencimento_hoje
WHATSAPP_TEMPLATE_D2=gate_one_atraso_d2
WHATSAPP_TEMPLATE_D5=gate_one_ultimo_aviso_d5
WHATSAPP_TEMPLATE_PAYMENT_CONFIRMED=gate_one_pagamento_confirmado
WHATSAPP_TEMPLATE_RENEWED=gate_one_renovacao_concluida
WHATSAPP_TEMPLATE_ACCESS_CREATED=gate_one_acesso_criado

# OpenAI: configure preferencialmente pelo administrador
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
AI_MAX_OUTPUT_TOKENS=700

# BitPanel: nunca coloque credenciais no código
BITPANEL_BASE_URL=https://bitpanel.vip
BITPANEL_LOGIN_URL=https://bitpanel.vip/login
BITPANEL_USERNAME=
BITPANEL_PASSWORD=
BITPANEL_PLAN_LABEL=30, R$ 30,00
BITPANEL_TV_PACKAGE=Full HD + H265 + HD + SD + VOD + Adulto
BITPANEL_DEFAULT_CONNECTIONS=1
BITPANEL_HEADLESS=true
ARTIFACTS_DIR=/app/artifacts
