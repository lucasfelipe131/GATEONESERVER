{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gateone.example/contracts/gate-core-v1.schema.json",
  "title": "GATE Core v1",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/event" },
    { "$ref": "#/$defs/customer360" },
    { "$ref": "#/$defs/contextSnapshot" }
  ],
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "enum": ["CUSTOMER", "ADMIN", "AGENT", "SYSTEM", "WORKER", "SERVICE"]
        },
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "capability": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1, "maxLength": 100 },
        "id": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "request_id",
        "correlation_id",
        "actor",
        "action",
        "subject",
        "input"
      ],
      "properties": {
        "contract_version": { "const": 1 },
        "request_id": { "type": "string", "format": "uuid" },
        "correlation_id": { "type": "string", "format": "uuid" },
        "actor": {
          "allOf": [
            { "$ref": "#/$defs/actor" },
            { "required": ["capability"] }
          ]
        },
        "action": { "type": "string", "minLength": 1, "maxLength": 200 },
        "subject": { "$ref": "#/$defs/subject" },
        "input": { "type": "object" }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "request_id",
        "correlation_id",
        "status",
        "data",
        "error"
      ],
      "properties": {
        "contract_version": { "const": 1 },
        "request_id": { "type": "string", "format": "uuid" },
        "correlation_id": { "type": "string", "format": "uuid" },
        "status": {
          "enum": ["SUCCESS", "PENDING", "REQUIRES_ACTION", "DENIED", "FAILED"]
        },
        "data": {},
        "error": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["code", "message"],
              "properties": {
                "code": {
                  "enum": [
                    "CUSTOMER_NOT_FOUND",
                    "CUSTOMER_IDENTITY_AMBIGUOUS",
                    "CUSTOMER_AMBIGUOUS",
                    "CONTEXT_UNAVAILABLE",
                    "CONTEXT_PARTIAL",
                    "SUBSCRIPTION_NOT_FOUND",
                    "INVALID_PURPOSE",
                    "INVALID_TRANSITION",
                    "PAYMENT_NOT_CONFIRMED",
                    "RENEWAL_ALREADY_COMPLETED",
                    "PROVIDER_UNAVAILABLE",
                    "HUMAN_ACTION_REQUIRED",
                    "INSUFFICIENT_CAPABILITY",
                    "STEP_UP_REQUIRED",
                    "UNSUPPORTED_ACTION",
                    "CONTRACT_VERSION_UNSUPPORTED",
                    "CORRELATION_MISMATCH"
                  ]
                },
                "message": { "type": "string", "minLength": 1, "maxLength": 500 },
                "details": { "type": "object" }
              }
            }
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source", "source_id", "observed_at", "freshness"],
      "properties": {
        "value": {},
        "source": { "type": "string", "minLength": 1, "maxLength": 100 },
        "source_id": { "type": ["string", "null"], "maxLength": 200 },
        "observed_at": { "type": "string", "format": "date-time" },
        "freshness": { "enum": ["CURRENT", "HISTORICAL", "STALE", "UNKNOWN"] }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_id", "customer_id", "type", "key", "value", "source",
        "source_reference", "confidence", "observed_at", "valid_from",
        "valid_until", "superseded_by", "status", "freshness"
      ],
      "properties": {
        "memory_id": { "type": "string", "format": "uuid" },
        "customer_id": { "type": "string", "format": "uuid" },
        "type": {
          "enum": [
            "IDENTITY_FACT", "PREFERENCE", "RELATIONSHIP", "SUPPORT_FACT",
            "COMMERCIAL_CONTEXT", "OPERATIONAL_NOTE"
          ]
        },
        "key": { "type": "string", "minLength": 1, "maxLength": 200 },
        "value": {},
        "source": { "type": "string", "minLength": 1, "maxLength": 100 },
        "source_reference": { "type": ["string", "null"], "maxLength": 500 },
        "confidence": { "enum": ["HIGH", "MEDIUM", "LOW"] },
        "observed_at": { "type": "string", "format": "date-time" },
        "valid_from": { "type": ["string", "null"], "format": "date-time" },
        "valid_until": { "type": ["string", "null"], "format": "date-time" },
        "superseded_by": { "type": ["string", "null"], "format": "uuid" },
        "status": { "enum": ["ACTIVE", "SUPERSEDED", "DISPUTED", "EXPIRED", "DELETED"] },
        "freshness": { "enum": ["CURRENT", "HISTORICAL", "STALE", "UNKNOWN"] }
      }
    },
    "customer360": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract", "customer_id", "resolution", "context_status",
        "selected_scopes", "missing_fields"
      ],
      "properties": {
        "contract": { "const": "Customer360.v1" },
        "customer_id": { "type": "string", "format": "uuid" },
        "resolution": {
          "type": "object",
          "required": ["status", "matched_by"],
          "properties": {
            "status": { "enum": ["MATCHED", "AMBIGUOUS", "NOT_FOUND"] },
            "matched_by": { "type": ["object", "null"] }
          }
        },
        "context_status": { "enum": ["COMPLETE", "PARTIAL"] },
        "selected_scopes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "IDENTITY", "LIFECYCLE", "SUBSCRIPTION", "PAYMENT", "RENEWAL",
              "CONVERSATION", "SUPPORT", "MEMORY", "PENDING_ACTIONS"
            ]
          }
        },
        "identity": { "type": "object" },
        "lifecycle": { "type": "object" },
        "subscription": { "type": ["object", "null"] },
        "financial": { "type": "object" },
        "renewal": { "type": ["object", "null"] },
        "conversation": { "type": ["object", "null"] },
        "support": { "type": "object" },
        "memories": { "type": "array", "items": { "$ref": "#/$defs/memory" } },
        "pending_actions": { "type": "array", "items": { "type": "object" } },
        "missing_fields": { "type": "array", "items": { "type": "string" } }
      }
    },
    "contextSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract", "context_snapshot_id", "customer_id", "correlation_id",
        "purpose", "channel", "created_at", "sources", "customer360",
        "freshness", "selected_refs", "excluded_refs", "exclusion_reason_codes"
      ],
      "properties": {
        "contract": { "const": "ContextSnapshot.v1" },
        "context_snapshot_id": { "type": "string", "format": "uuid" },
        "customer_id": { "type": "string", "format": "uuid" },
        "correlation_id": { "type": "string", "format": "uuid" },
        "purpose": { "enum": ["CONVERSATION", "RENEWAL", "PAYMENT", "SUPPORT", "SALES"] },
        "channel": { "type": "string", "minLength": 1, "maxLength": 100 },
        "created_at": { "type": "string", "format": "date-time" },
        "sources": { "type": "array", "items": { "type": "object" } },
        "customer360": { "$ref": "#/$defs/customer360" },
        "freshness": { "type": "object" },
        "selected_refs": { "type": "array", "items": { "type": "object" } },
        "excluded_refs": { "type": "array", "items": { "type": "object" } },
        "exclusion_reason_codes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_type",
        "event_version",
        "occurred_at",
        "correlation_id",
        "causation_id",
        "actor",
        "subject",
        "payload"
      ],
      "properties": {
        "event_id": { "type": "string", "format": "uuid" },
        "event_type": {
          "enum": [
            "customer.created",
            "customer.identified",
            "customer.status_changed",
            "lead.created",
            "lead.qualified",
            "payment.created",
            "payment.pending",
            "payment.confirmed",
            "payment.failed",
            "subscription.created",
            "subscription.activated",
            "subscription.expiring",
            "subscription.expired",
            "renewal.requested",
            "renewal.ready",
            "renewal.processing",
            "renewal.completed",
            "renewal.failed",
            "provisioning.requested",
            "provisioning.completed",
            "provisioning.failed",
            "provisioning.human_action_required",
            "conversation.started",
            "message.received",
            "message.sent",
            "conversation.handoff_requested",
            "support.case_opened",
            "support.case_resolved"
          ]
        },
        "event_version": { "const": 1 },
        "occurred_at": { "type": "string", "format": "date-time" },
        "correlation_id": { "type": "string", "format": "uuid" },
        "causation_id": {
          "type": ["string", "null"],
          "format": "uuid"
        },
        "actor": { "$ref": "#/$defs/actor" },
        "subject": { "$ref": "#/$defs/subject" },
        "payload": { "type": "object" }
      }
    }
  }
}
